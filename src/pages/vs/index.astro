---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/schema';
const path = '/vs/';
const title = 'Comparisons: Numerology & Frequency Terms Explained';
const description = 'Clear, side-by-side comparisons of the terms people mix up most — starting with life path number vs angel number.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Comparisons', href: path }];
const guides = [
  { name: 'Life Path Number vs Angel Number', href: '/vs/life-path-vs-angel-number/', blurb: "What's actually different between your life path number and the angel numbers you keep seeing." },
  ];
  const schema = [breadcrumbSchema(crumbs)];
  ---
  <Base title={title} description={description} schema={schema}>
  <div class="wrap" style="max-width:900px">
  <Breadcrumbs crumbs={crumbs} />
  <header class="hero"><p class="eyebrow">Comparisons</p><h1>Comparisons</h1>
  <p class="lead">Side-by-side answers to the terms people mix up most.</p></header>
  <ul class="hub-grid">{guides.map((g) => (<li><a class="hub-card" href={g.href}><h3>{g.name}</h3><p>{g.blurb}</p></a></li>))}</ul>
  <p class="muted">Coming next: 432Hz vs 528Hz, binaural beats vs healing frequencies, life path vs expression number.</p>
  </div>
  </Base>
  
